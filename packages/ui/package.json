{
  "name": "@ngb/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input",
