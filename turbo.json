{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".nvmrc"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    },
    "test:stories": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["@ngb/web#build"],
      "env": ["NEXT_PUBLIC_*", "BASE_URL"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "lhci": {
      "dependsOn": ["build"],
      "cache": false
    },
    "visual": {
      "dependsOn": ["@ngb/ui#build-storybook"],
      "outputs": ["visual-report/**"]
    }
  }
}
