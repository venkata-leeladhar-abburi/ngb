{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".nvmrc"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:stories": {
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["@ngb/web#build"],
      "env": ["NEXT_PUBLIC_*", "BASE_URL"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "lhci": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
