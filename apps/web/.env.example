# Copy to .env.local for local development. Never commit real values.
# Validated at build and start by env.ts; a missing required value fails the build.

# Public site origin, used for canonical URLs, Open Graph and the sitemap.
# Required on Vercel production; defaults to http://localhost:3000 elsewhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development needs none of the values below: `pnpm dev` sets NGB_LOCAL_SERVICES=1, which
# runs an in-process Postgres (data in .data/), in-memory rate limits and a local SMS outbox.
# That switch is ignored on Vercel.

# Postgres in Mumbai, pooled connection string. Required for any real deployment.
# DATABASE_URL=postgres://user:password@host:5432/ngb

# Keys the OTP hashes. Required in production. Generate with: openssl rand -base64 48
# AUTH_SECRET=

# Later phase 7 steps add: REDIS_URL, RAZORPAY_*, MSG91_*, WHATSAPP_*, PAYLOAD_SECRET.
